<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CouponX — The Smart Coupon Marketplace</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #080c14;
    --surface: #0f1520;
    --surface2: #161e2e;
    --border: rgba(255,255,255,0.07);
    --accent: #00e5a0;
    --accent2: #7c3aed;
    --accent3: #f59e0b;
    --text: #e8edf5;
    --muted: #6b7a99;
    --danger: #ef4444;
    --good: #00e5a0;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
    overflow-x: hidden;
  }

  /* NAV */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(8,12,20,0.85);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    padding: 0 2rem;
    height: 64px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .nav-logo {
    font-family: 'Syne', sans-serif;
    font-weight: 800; font-size: 1.4rem;
    background: linear-gradient(135deg, var(--accent), #00b4ff);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  }
  .nav-links { display: flex; gap: 2rem; }
  .nav-links a {
    color: var(--muted); text-decoration: none; font-size: 0.9rem;
    transition: color 0.2s; cursor: pointer;
  }
  .nav-links a:hover { color: var(--text); }
  .nav-cta {
    background: var(--accent); color: #000;
    border: none; padding: 0.5rem 1.2rem;
    border-radius: 8px; font-weight: 600;
    cursor: pointer; font-size: 0.9rem;
    transition: opacity 0.2s;
  }
  .nav-cta:hover { opacity: 0.85; }

  /* HERO */
  #hero {
    min-height: 100vh;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 6rem 1.5rem 4rem;
    position: relative; overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(ellipse 60% 50% at 50% 10%, rgba(0,229,160,0.12) 0%, transparent 70%),
      radial-gradient(ellipse 40% 40% at 80% 80%, rgba(124,58,237,0.1) 0%, transparent 60%);
  }
  .hero-tag {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: rgba(0,229,160,0.1); border: 1px solid rgba(0,229,160,0.25);
    color: var(--accent); padding: 0.35rem 1rem; border-radius: 100px;
    font-size: 0.8rem; font-weight: 500; margin-bottom: 1.5rem;
    animation: fadeUp 0.6s ease both;
  }
  .hero-tag span { width: 6px; height: 6px; background: var(--accent); border-radius: 50%; animation: pulse 1.5s ease infinite; }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
  h1 {
    font-family: 'Syne', sans-serif; font-weight: 800;
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    line-height: 1.05; margin-bottom: 1.2rem;
    animation: fadeUp 0.7s 0.1s ease both;
  }
  h1 em { font-style: normal; color: var(--accent); }
  .hero-sub {
    color: var(--muted); font-size: clamp(1rem, 2vw, 1.2rem);
    max-width: 600px; line-height: 1.7;
    animation: fadeUp 0.7s 0.2s ease both;
  }
  .hero-stats {
    display: flex; gap: 2.5rem; margin-top: 3rem; flex-wrap: wrap; justify-content: center;
    animation: fadeUp 0.7s 0.35s ease both;
  }
  .stat { text-align: center; }
  .stat-num { font-family: 'Syne', sans-serif; font-size: 2rem; font-weight: 800; color: var(--accent); }
  .stat-label { color: var(--muted); font-size: 0.8rem; margin-top: 0.2rem; }
  .hero-cta {
    display: flex; gap: 1rem; margin-top: 2.5rem; flex-wrap: wrap; justify-content: center;
    animation: fadeUp 0.7s 0.4s ease both;
  }
  .btn-primary {
    background: var(--accent); color: #000;
    border: none; padding: 0.85rem 2rem;
    border-radius: 10px; font-weight: 700; font-size: 1rem;
    cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 0 30px rgba(0,229,160,0.3);
  }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 4px 40px rgba(0,229,160,0.4); }
  .btn-secondary {
    background: transparent; color: var(--text);
    border: 1px solid var(--border); padding: 0.85rem 2rem;
    border-radius: 10px; font-weight: 500; font-size: 1rem;
    cursor: pointer; transition: border-color 0.2s, background 0.2s;
  }
  .btn-secondary:hover { border-color: rgba(255,255,255,0.2); background: rgba(255,255,255,0.04); }

  @keyframes fadeUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }

  /* SECTION */
  section { padding: 6rem 1.5rem; max-width: 1200px; margin: 0 auto; }
  .section-tag {
    display: inline-block; background: rgba(124,58,237,0.1);
    border: 1px solid rgba(124,58,237,0.3); color: #a78bfa;
    padding: 0.3rem 0.9rem; border-radius: 100px; font-size: 0.75rem;
    font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .section-tag.green { background: rgba(0,229,160,0.1); border-color: rgba(0,229,160,0.3); color: var(--accent); }
  .section-tag.amber { background: rgba(245,158,11,0.1); border-color: rgba(245,158,11,0.3); color: var(--accent3); }
  h2 {
    font-family: 'Syne', sans-serif; font-weight: 800;
    font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 1rem;
  }
  .section-sub { color: var(--muted); font-size: 1.05rem; line-height: 1.7; max-width: 580px; }

  /* PROBLEM */
  .problem-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.2rem; margin-top: 3rem;
  }
  .problem-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 16px; padding: 1.6rem;
    transition: border-color 0.2s, transform 0.2s;
  }
  .problem-card:hover { border-color: rgba(255,255,255,0.15); transform: translateY(-3px); }
  .problem-icon { font-size: 2rem; margin-bottom: 1rem; }
  .problem-card h3 { font-family: 'Syne', sans-serif; font-size: 1.1rem; margin-bottom: 0.5rem; }
  .problem-card p { color: var(--muted); font-size: 0.9rem; line-height: 1.6; }

  /* TABS (Marketplace) */
  #marketplace { scroll-margin-top: 80px; }
  .tabs {
    display: flex; gap: 0; background: var(--surface);
    border: 1px solid var(--border); border-radius: 12px;
    padding: 4px; width: fit-content; margin-bottom: 2rem;
  }
  .tab {
    padding: 0.6rem 1.5rem; border-radius: 9px; cursor: pointer;
    font-weight: 500; font-size: 0.9rem; transition: all 0.2s;
    color: var(--muted); border: none; background: transparent;
  }
  .tab.active { background: var(--accent2); color: #fff; }

  /* COUPON GRID */
  .coupon-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.2rem;
  }
  .coupon-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 18px; overflow: hidden;
    transition: transform 0.2s, border-color 0.2s;
    position: relative;
  }
  .coupon-card:hover { transform: translateY(-4px); border-color: rgba(255,255,255,0.15); }
  .coupon-top {
    padding: 1.4rem;
    background: linear-gradient(135deg, var(--surface2), var(--surface));
    border-bottom: 1px dashed rgba(255,255,255,0.1);
    display: flex; justify-content: space-between; align-items: flex-start;
  }
  .coupon-brand { font-family: 'Syne', sans-serif; font-size: 1.1rem; font-weight: 700; }
  .coupon-category {
    font-size: 0.72rem; color: var(--muted); margin-top: 0.25rem;
    text-transform: uppercase; letter-spacing: 0.06em;
  }
  .deal-badge {
    background: linear-gradient(135deg, var(--accent), #00b4ff);
    color: #000; font-weight: 800; font-size: 0.8rem;
    padding: 0.35rem 0.7rem; border-radius: 8px;
    white-space: nowrap;
  }
  .coupon-bottom { padding: 1.2rem 1.4rem; }
  .coupon-code {
    font-family: monospace; font-size: 1.1rem; font-weight: 700;
    background: rgba(255,255,255,0.05); padding: 0.5rem 0.8rem;
    border-radius: 8px; display: flex; align-items: center;
    justify-content: space-between; margin-bottom: 1rem;
    border: 1px solid var(--border);
  }
  .copy-btn {
    background: none; border: none; color: var(--accent);
    cursor: pointer; font-size: 0.75rem; font-weight: 600;
    transition: opacity 0.2s;
  }
  .copy-btn:hover { opacity: 0.7; }
  .coupon-meta {
    display: flex; justify-content: space-between;
    align-items: center; font-size: 0.82rem; color: var(--muted);
    margin-bottom: 1rem;
  }
  .expiry { color: var(--accent3); font-weight: 500; }
  .expiry.urgent { color: var(--danger); animation: blink 1.5s ease infinite; }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.5} }
  .coupon-price {
    display: flex; justify-content: space-between; align-items: center;
  }
  .original-val { color: var(--muted); text-decoration: line-through; font-size: 0.85rem; }
  .sale-price { font-family: 'Syne', sans-serif; font-size: 1.3rem; font-weight: 800; color: var(--accent); }
  .buy-btn {
    background: var(--accent2); color: #fff;
    border: none; padding: 0.6rem 1.2rem;
    border-radius: 8px; font-weight: 600; font-size: 0.85rem;
    cursor: pointer; transition: opacity 0.2s;
  }
  .buy-btn:hover { opacity: 0.8; }

  /* Deal Score Bar */
  .deal-score-wrap { margin: 0.8rem 0; }
  .deal-score-label { display: flex; justify-content: space-between; font-size: 0.75rem; margin-bottom: 0.3rem; }
  .deal-score-bar { height: 6px; background: rgba(255,255,255,0.07); border-radius: 100px; overflow: hidden; }
  .deal-score-fill { height: 100%; border-radius: 100px; transition: width 1s ease; }

  /* SELL FORM */
  #sell { scroll-margin-top: 80px; }
  .sell-form {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 20px; padding: 2.5rem; max-width: 640px;
    margin-top: 2.5rem;
  }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-bottom: 1.2rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .form-group label { font-size: 0.82rem; color: var(--muted); font-weight: 500; }
  .form-group input, .form-group select {
    background: var(--surface2); border: 1px solid var(--border);
    border-radius: 10px; color: var(--text); padding: 0.7rem 1rem;
    font-size: 0.9rem; outline: none;
    transition: border-color 0.2s;
    font-family: 'DM Sans', sans-serif;
  }
  .form-group input:focus, .form-group select:focus { border-color: var(--accent); }
  .form-group input::placeholder { color: var(--muted); }
  .form-group select option { background: var(--surface2); }
  .submit-btn {
    width: 100%; background: var(--accent); color: #000;
    border: none; padding: 0.9rem;
    border-radius: 10px; font-weight: 700; font-size: 1rem;
    cursor: pointer; transition: opacity 0.2s; margin-top: 0.5rem;
    font-family: 'DM Sans', sans-serif;
  }
  .submit-btn:hover { opacity: 0.85; }

  /* AI VALUATION */
  #ai-chat { scroll-margin-top: 80px; }
  .chat-container {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;
    margin-top: 2.5rem;
  }
  @media(max-width:768px){ .chat-container { grid-template-columns: 1fr; } }
  .chat-window {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 20px; overflow: hidden; height: 500px;
    display: flex; flex-direction: column;
  }
  .chat-header {
    padding: 1rem 1.4rem; border-bottom: 1px solid var(--border);
    background: var(--surface2);
    display: flex; align-items: center; gap: 0.75rem;
  }
  .ai-dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--accent); animation: pulse 1.5s ease infinite;
  }
  .chat-title { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.95rem; }
  .chat-messages {
    flex: 1; overflow-y: auto; padding: 1.2rem;
    display: flex; flex-direction: column; gap: 0.9rem;
  }
  .chat-messages::-webkit-scrollbar { width: 4px; }
  .chat-messages::-webkit-scrollbar-track { background: transparent; }
  .chat-messages::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 2px; }
  .msg {
    display: flex; gap: 0.7rem; align-items: flex-start;
  }
  .msg.user { flex-direction: row-reverse; }
  .msg-avatar {
    width: 30px; height: 30px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.8rem; flex-shrink: 0; font-weight: 600;
  }
  .msg-avatar.ai { background: linear-gradient(135deg, var(--accent), #00b4ff); color: #000; }
  .msg-avatar.user { background: var(--accent2); color: #fff; }
  .msg-bubble {
    max-width: 75%; padding: 0.7rem 1rem;
    border-radius: 12px; font-size: 0.88rem; line-height: 1.55;
  }
  .msg.ai .msg-bubble { background: var(--surface2); border: 1px solid var(--border); }
  .msg.user .msg-bubble { background: var(--accent2); color: #fff; }
  .chat-input-row {
    display: flex; gap: 0.6rem; padding: 1rem;
    border-top: 1px solid var(--border); background: var(--surface2);
  }
  .chat-input {
    flex: 1; background: var(--surface); border: 1px solid var(--border);
    border-radius: 10px; color: var(--text); padding: 0.65rem 1rem;
    font-size: 0.88rem; outline: none;
    font-family: 'DM Sans', sans-serif;
    transition: border-color 0.2s;
  }
  .chat-input:focus { border-color: var(--accent); }
  .send-btn {
    background: var(--accent); color: #000;
    border: none; width: 38px; height: 38px;
    border-radius: 10px; cursor: pointer; font-size: 1.1rem;
    transition: opacity 0.2s; display: flex; align-items: center; justify-content: center;
  }
  .send-btn:hover { opacity: 0.8; }

  /* Valuation panel */
  .valuation-panel {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 20px; padding: 1.6rem;
    display: flex; flex-direction: column; gap: 1rem; height: 500px; overflow-y: auto;
  }
  .val-title { font-family: 'Syne', sans-serif; font-size: 1rem; font-weight: 700; margin-bottom: 0.3rem; }
  .val-subtitle { color: var(--muted); font-size: 0.82rem; margin-bottom: 1rem; }
  .val-coupon {
    background: var(--surface2); border: 1px solid var(--border);
    border-radius: 12px; padding: 1rem;
    cursor: pointer; transition: border-color 0.2s;
  }
  .val-coupon:hover { border-color: var(--accent); }
  .val-coupon.active { border-color: var(--accent); }
  .val-top { display: flex; justify-content: space-between; margin-bottom: 0.6rem; }
  .val-brand { font-weight: 600; font-size: 0.95rem; }
  .val-worth { font-family: 'Syne', sans-serif; font-weight: 800; color: var(--accent); }
  .val-bar-wrap { margin: 0.4rem 0; }
  .val-bar { height: 8px; background: rgba(255,255,255,0.06); border-radius: 100px; overflow: hidden; }
  .val-fill { height: 100%; border-radius: 100px; }
  .val-meta { font-size: 0.75rem; color: var(--muted); margin-top: 0.4rem; }
  .score-pill {
    display: inline-flex; align-items: center; gap: 0.3rem;
    padding: 0.25rem 0.65rem; border-radius: 100px;
    font-size: 0.72rem; font-weight: 700; margin-top: 0.5rem;
  }

  /* HOW IT WORKS */
  #how { scroll-margin-top: 80px; }
  .steps {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem; margin-top: 3rem; position: relative;
  }
  .step-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 16px; padding: 1.8rem; position: relative;
    transition: transform 0.2s;
  }
  .step-card:hover { transform: translateY(-4px); }
  .step-num {
    font-family: 'Syne', sans-serif; font-size: 3rem; font-weight: 800;
    color: rgba(0,229,160,0.15); position: absolute; top: 1rem; right: 1.2rem;
  }
  .step-icon { font-size: 1.8rem; margin-bottom: 1rem; }
  .step-card h3 { font-family: 'Syne', sans-serif; font-size: 1rem; margin-bottom: 0.5rem; }
  .step-card p { color: var(--muted); font-size: 0.85rem; line-height: 1.6; }

  /* NOTIFICATION TOAST */
  #toast {
    position: fixed; bottom: 2rem; right: 2rem; z-index: 999;
    background: var(--surface); border: 1px solid var(--accent);
    color: var(--text); padding: 0.9rem 1.4rem;
    border-radius: 12px; font-size: 0.9rem;
    transform: translateY(100px); opacity: 0;
    transition: all 0.3s ease; pointer-events: none;
    display: flex; align-items: center; gap: 0.6rem;
  }
  #toast.show { transform: translateY(0); opacity: 1; }

  /* Modal */
  .modal-overlay {
    position: fixed; inset: 0; z-index: 200;
    background: rgba(0,0,0,0.8); backdrop-filter: blur(8px);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none; transition: opacity 0.2s;
  }
  .modal-overlay.open { opacity: 1; pointer-events: all; }
  .modal {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 24px; padding: 2.5rem; max-width: 460px; width: 90%;
    transform: scale(0.9); transition: transform 0.2s;
  }
  .modal-overlay.open .modal { transform: scale(1); }
  .modal-title { font-family: 'Syne', sans-serif; font-size: 1.4rem; font-weight: 800; margin-bottom: 0.5rem; }
  .modal-sub { color: var(--muted); font-size: 0.88rem; margin-bottom: 1.5rem; }
  .modal-close {
    position: absolute; top: 1.2rem; right: 1.5rem;
    background: none; border: none; color: var(--muted);
    font-size: 1.4rem; cursor: pointer; line-height: 1;
  }
  .modal { position: relative; }
  .confirmed-icon { font-size: 3rem; text-align: center; margin-bottom: 1rem; }

  /* Footer */
  footer {
    background: var(--surface); border-top: 1px solid var(--border);
    padding: 3rem 2rem; text-align: center; color: var(--muted); font-size: 0.85rem;
  }
  .footer-logo {
    font-family: 'Syne', sans-serif; font-size: 1.6rem; font-weight: 800;
    background: linear-gradient(135deg, var(--accent), #00b4ff);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    margin-bottom: 0.5rem;
  }

  /* Typing indicator */
  .typing { display: flex; gap: 4px; align-items: center; padding: 0.3rem 0; }
  .typing span {
    width: 6px; height: 6px; border-radius: 50%; background: var(--muted);
    animation: typingBounce 1s ease infinite;
  }
  .typing span:nth-child(2) { animation-delay: 0.15s; }
  .typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes typingBounce { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-5px)} }

  /* scroll fade-in */
  .fade-in { opacity: 0; transform: translateY(20px); transition: opacity 0.5s ease, transform 0.5s ease; }
  .fade-in.visible { opacity: 1; transform: translateY(0); }

  @media(max-width:640px){
    .form-row { grid-template-columns: 1fr; }
    .nav-links { display: none; }
    .hero-stats { gap: 1.5rem; }
  }
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="nav-logo">CouponX</div>
  <div class="nav-links">
    <a onclick="scrollTo('marketplace')">Marketplace</a>
    <a onclick="scrollTo('sell')">Sell</a>
    <a onclick="scrollTo('ai-chat')">AI Valuator</a>
    <a onclick="scrollTo('how')">How it Works</a>
  </div>
  <button class="nav-cta" onclick="scrollTo('marketplace')">Browse Coupons</button>
</nav>

<!-- HERO -->
<div id="hero">
  <div class="hero-bg"></div>
  <div class="hero-tag"><span></span> Live Marketplace · AI-Powered Validation</div>
  <h1>Turn Unused Coupons<br>Into <em>Real Money</em></h1>
  <p class="hero-sub">Millions of coupons expire every year. CouponX is a smart marketplace where you can buy, sell, and validate coupons — powered by AI that ensures every deal is legit.</p>
  <div class="hero-stats">
    <div class="stat"><div class="stat-num">₹4.2B</div><div class="stat-label">Lost Annually to Expiry</div></div>
    <div class="stat"><div class="stat-num">340M+</div><div class="stat-label">Coupons Wasted / Year</div></div>
    <div class="stat"><div class="stat-num">98%</div><div class="stat-label">Fraud Detection Rate</div></div>
    <div class="stat"><div class="stat-num">12K+</div><div class="stat-label">Active Users</div></div>
  </div>
  <div class="hero-cta">
    <button class="btn-primary" onclick="scrollTo('marketplace')">🛒 Browse Coupons</button>
    <button class="btn-secondary" onclick="scrollTo('sell')">💰 Sell My Coupon</button>
  </div>
</div>

<!-- PROBLEM -->
<section class="fade-in">
  <div class="section-tag">The Problem</div>
  <h2>Billions Wasted.<br>Every. Single. Year.</h2>
  <p class="section-sub">Coupons are distributed at massive scale, but most of them never get used. Sellers can't monetise what they don't need. Buyers miss deals that never reach them.</p>
  <div class="problem-grid">
    <div class="problem-card">
      <div class="problem-icon">💸</div>
      <h3>Value Lost to Expiry</h3>
      <p>Estimated billions in coupon value expire unused globally each year — money that could have been saved or earned.</p>
    </div>
    <div class="problem-card">
      <div class="problem-icon">🚫</div>
      <h3>Fake & Fraudulent Coupons</h3>
      <p>No verification means buyers routinely receive fake or already-used coupons, destroying trust in any marketplace.</p>
    </div>
    <div class="problem-card">
      <div class="problem-icon">📍</div>
      <h3>Location & Condition Gaps</h3>
      <p>Buyers don't know if a coupon works in their region, or under what conditions — leading to wasted purchases.</p>
    </div>
    <div class="problem-card">
      <div class="problem-icon">🤷</div>
      <h3>No Smart Pricing</h3>
      <p>Existing platforms use fixed, low-ball pricing. There's no dynamic model that reflects a coupon's real-world demand and usability.</p>
    </div>
  </div>
</section>

<!-- MARKETPLACE -->
<section id="marketplace" class="fade-in" style="padding-top: 3rem;">
  <div class="section-tag green">Live Marketplace</div>
  <h2>Buy Verified Coupons</h2>
  <p class="section-sub">Every coupon below has been AI-validated in real-time. Our Deal Score shows how good the deal actually is.</p>

  <div class="tabs" style="margin-top: 2rem;">
    <button class="tab active" onclick="filterCoupons('all', this)">All</button>
    <button class="tab" onclick="filterCoupons('food', this)">🍕 Food</button>
    <button class="tab" onclick="filterCoupons('shopping', this)">🛍 Shopping</button>
    <button class="tab" onclick="filterCoupons('travel', this)">✈️ Travel</button>
    <button class="tab" onclick="filterCoupons('health', this)">💊 Health</button>
  </div>

  <div class="coupon-grid" id="couponGrid"></div>
</section>

<!-- SELL -->
<section id="sell" class="fade-in">
  <div class="section-tag amber">Sell Your Coupon</div>
  <h2>List in 60 Seconds</h2>
  <p class="section-sub">Our AI instantly validates your coupon, scores its real-world value, and prices it dynamically — giving you the best possible return.</p>
  <div class="sell-form">
    <div class="form-row">
      <div class="form-group">
        <label>Brand / Platform</label>
        <input id="sf-brand" type="text" placeholder="e.g. Swiggy, Amazon...">
      </div>
      <div class="form-group">
        <label>Category</label>
        <select id="sf-cat">
          <option value="">Select category</option>
          <option>Food & Dining</option>
          <option>Shopping</option>
          <option>Travel</option>
          <option>Health & Wellness</option>
          <option>Entertainment</option>
        </select>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Coupon Code</label>
        <input id="sf-code" type="text" placeholder="e.g. SAVE200">
      </div>
      <div class="form-group">
        <label>Face Value (₹)</label>
        <input id="sf-value" type="number" placeholder="e.g. 500">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Expiry Date</label>
        <input id="sf-expiry" type="date">
      </div>
      <div class="form-group">
        <label>Min. Order Value (₹)</label>
        <input id="sf-min" type="number" placeholder="e.g. 999">
      </div>
    </div>
    <button class="submit-btn" onclick="submitCoupon()">🤖 Validate & List Coupon →</button>
  </div>
</section>

<!-- AI CHAT -->
<section id="ai-chat" class="fade-in">
  <div class="section-tag">AI Valuator</div>
  <h2>Ask the AI Deal Analyst</h2>
  <p class="section-sub">Our AI evaluates coupon conditions, expiry proximity, demand, and category trends to tell you exactly how much a coupon is worth — and whether to buy it.</p>

  <div class="chat-container">
    <!-- Chat window -->
    <div class="chat-window">
      <div class="chat-header">
        <div class="ai-dot"></div>
        <div>
          <div class="chat-title">CouponX AI Assistant</div>
          <div style="font-size:0.7rem; color: var(--muted);">Powered by deal intelligence</div>
        </div>
      </div>
      <div class="chat-messages" id="chatMessages">
        <div class="msg ai">
          <div class="msg-avatar ai">🤖</div>
          <div class="msg-bubble">Hi! I'm your deal analyst. Ask me anything — "Is the Swiggy coupon worth buying?" or paste a coupon code and I'll score it for you. 🎯</div>
        </div>
      </div>
      <div class="chat-input-row">
        <input class="chat-input" id="chatInput" placeholder="Ask about any coupon..." onkeydown="if(event.key==='Enter') sendMessage()">
        <button class="send-btn" onclick="sendMessage()">➤</button>
      </div>
    </div>

    <!-- Valuation panel -->
    <div class="valuation-panel">
      <div>
        <div class="val-title">Live Coupon Valuations</div>
        <div class="val-subtitle">Click any coupon to load it into the AI chat</div>
      </div>
      <div id="valuationCards"></div>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section id="how" class="fade-in">
  <div class="section-tag green">How It Works</div>
  <h2>Verified. Safe. Smart.</h2>
  <p class="section-sub">Our agent-based system ensures no fake coupon ever reaches a buyer. Payment is held in escrow until validation is complete.</p>
  <div class="steps">
    <div class="step-card"><div class="step-num">01</div><div class="step-icon">📋</div><h3>Seller Lists</h3><p>Seller submits coupon details — brand, code, value, expiry. AI pre-screens for duplicates and anomalies instantly.</p></div>
    <div class="step-card"><div class="step-num">02</div><div class="step-icon">🤖</div><h3>AI Validates</h3><p>Real-time API validation with partner platforms confirms the coupon is live, unused, and redeemable right now.</p></div>
    <div class="step-card"><div class="step-num">03</div><div class="step-icon">💰</div><h3>Escrow Hold</h3><p>Buyer pays. Funds enter escrow. Neither party can access the money until validation is confirmed — 100% safe.</p></div>
    <div class="step-card"><div class="step-num">04</div><div class="step-icon">✅</div><h3>OTP Transfer</h3><p>OTP-based coupon transfer with identity verification. Seller receives payment. Buyer receives a verified, working code.</p></div>
    <div class="step-card"><div class="step-num">05</div><div class="step-icon">⭐</div><h3>Rate & Build Trust</h3><p>Both parties rate each other. Our AI monitors for suspicious patterns and bad actors continuously.</p></div>
  </div>
</section>

<!-- FOOTER -->
<footer>
  <div class="footer-logo">CouponX</div>
  <p>The Smart Coupon Marketplace · AI-Powered · Escrow-Protected</p>
  <p style="margin-top: 0.5rem; font-size: 0.75rem;">Built to solve ₹4.2 Billion in annual coupon waste — one verified deal at a time.</p>
</footer>

<!-- TOAST -->
<div id="toast">✅ <span id="toastMsg">Done!</span></div>

<!-- BUY MODAL -->
<div class="modal-overlay" id="buyModal">
  <div class="modal">
    <button class="modal-close" onclick="closeModal()">×</button>
    <div class="confirmed-icon">🎉</div>
    <div class="modal-title" id="modalTitle">Purchase Confirmed!</div>
    <div class="modal-sub" id="modalSub">Your payment is held in escrow. The seller has been notified. You'll receive an OTP to claim your coupon once validation is complete.</div>
    <div id="modalCode" style="background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:1rem;text-align:center;font-family:monospace;font-size:1.2rem;font-weight:700;margin-bottom:1rem;"></div>
    <button class="submit-btn" onclick="closeModal()">Got it! 🚀</button>
  </div>
</div>

<script>
// DATA
const coupons = [
  { id:1, brand:'Swiggy', cat:'food', code:'SWIG300', desc:'₹300 off on orders above ₹699', faceVal:300, salePrice:149, expiry:'2025-07-15', deal:88, minOrder:699, urgent:false },
  { id:2, brand:'Amazon', cat:'shopping', code:'AMZN500', desc:'₹500 off on electronics above ₹2999', faceVal:500, salePrice:199, expiry:'2025-06-28', deal:72, minOrder:2999, urgent:false },
  { id:3, brand:'MakeMyTrip', cat:'travel', code:'MMT1500', desc:'₹1500 off on flights', faceVal:1500, salePrice:599, expiry:'2025-06-22', deal:65, minOrder:5000, urgent:true },
  { id:4, brand:'Zomato', cat:'food', code:'ZOM200', desc:'₹200 off, no minimum order', faceVal:200, salePrice:89, expiry:'2025-07-30', deal:94, minOrder:0, urgent:false },
  { id:5, brand:'Myntra', cat:'shopping', code:'MYN700', desc:'₹700 off on fashion above ₹1999', faceVal:700, salePrice:249, expiry:'2025-07-10', deal:78, minOrder:1999, urgent:false },
  { id:6, brand:'Cult.fit', cat:'health', code:'CULT999', desc:'₹999 off 3-month membership', faceVal:999, salePrice:399, expiry:'2025-08-01', deal:82, minOrder:0, urgent:false },
  { id:7, brand:'Ola', cat:'travel', code:'OLA150', desc:'₹150 off 3 rides', faceVal:150, salePrice:59, expiry:'2025-06-25', deal:58, minOrder:0, urgent:true },
  { id:8, brand:'PharmEasy', cat:'health', code:'PHARMA20', desc:'20% off on medicines', faceVal:300, salePrice:99, expiry:'2025-07-20', deal:76, minOrder:499, urgent:false },
];

let activeFilter = 'all';

function getDealColor(score) {
  if (score >= 80) return '#00e5a0';
  if (score >= 60) return '#f59e0b';
  return '#ef4444';
}
function getDealLabel(score) {
  if (score >= 80) return '🔥 Hot Deal';
  if (score >= 60) return '👍 Good Deal';
  return '⚠️ Weak Deal';
}
function getDaysLeft(expiry) {
  const diff = Math.ceil((new Date(expiry) - Date.now()) / 86400000);
  return diff;
}

function renderCoupons(filter) {
  const grid = document.getElementById('couponGrid');
  const filtered = filter === 'all' ? coupons : coupons.filter(c => c.cat === filter);
  grid.innerHTML = filtered.map(c => {
    const days = getDaysLeft(c.expiry);
    const color = getDealColor(c.deal);
    return `
    <div class="coupon-card" data-cat="${c.cat}">
      <div class="coupon-top">
        <div>
          <div class="coupon-brand">${c.brand}</div>
          <div class="coupon-category">${c.cat.toUpperCase()} · ${c.desc}</div>
        </div>
        <div class="deal-badge" style="background: linear-gradient(135deg, ${color}, ${color}99)">${c.deal}% Deal</div>
      </div>
      <div class="coupon-bottom">
        <div class="coupon-code">
          <span>${c.code}</span>
          <button class="copy-btn" onclick="copyCode('${c.code}', this)">COPY</button>
        </div>
        <div class="deal-score-wrap">
          <div class="deal-score-label">
            <span style="font-size:0.73rem;color:var(--muted)">Deal Score</span>
            <span style="font-size:0.73rem;font-weight:700;color:${color}">${getDealLabel(c.deal)}</span>
          </div>
          <div class="deal-score-bar">
            <div class="deal-score-fill" style="width:${c.deal}%;background:linear-gradient(90deg,${color},${color}99)"></div>
          </div>
        </div>
        <div class="coupon-meta">
          <span>Min. order: ${c.minOrder > 0 ? '₹'+c.minOrder : 'None'}</span>
          <span class="expiry ${days <= 5 ? 'urgent' : ''}">⏱ ${days}d left</span>
        </div>
        <div class="coupon-price">
          <div><div class="original-val">Worth ₹${c.faceVal}</div><div class="sale-price">₹${c.salePrice}</div></div>
          <button class="buy-btn" onclick="buyCoupon(${c.id})">Buy Now →</button>
        </div>
      </div>
    </div>`;
  }).join('');
}

function filterCoupons(cat, btn) {
  activeFilter = cat;
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  btn.classList.add('active');
  renderCoupons(cat);
}

function copyCode(code, btn) {
  navigator.clipboard.writeText(code).catch(()=>{});
  btn.textContent = '✓ COPIED';
  btn.style.color = '#00e5a0';
  setTimeout(()=>{ btn.textContent = 'COPY'; btn.style.color = ''; }, 1500);
}

function buyCoupon(id) {
  const c = coupons.find(x => x.id === id);
  document.getElementById('modalTitle').textContent = `Buying ${c.brand} Coupon`;
  document.getElementById('modalSub').textContent = `You're purchasing "${c.desc}" for ₹${c.salePrice}. Payment held in escrow. OTP verification will be triggered once AI validation completes.`;
  document.getElementById('modalCode').textContent = c.code;
  document.getElementById('buyModal').classList.add('open');
}
function closeModal() { document.getElementById('buyModal').classList.remove('open'); }

// Valuation panel
function renderValuations() {
  const el = document.getElementById('valuationCards');
  el.innerHTML = coupons.map(c => {
    const color = getDealColor(c.deal);
    return `
    <div class="val-coupon" onclick="loadCouponInChat(${c.id})">
      <div class="val-top">
        <span class="val-brand">${c.brand}</span>
        <span class="val-worth">₹${c.faceVal} → ₹${c.salePrice}</span>
      </div>
      <div class="val-bar-wrap">
        <div class="val-bar"><div class="val-fill" style="width:${c.deal}%;background:${color}"></div></div>
      </div>
      <div class="val-meta">${c.desc}</div>
      <span class="score-pill" style="background:${color}22;color:${color};border:1px solid ${color}44">${getDealLabel(c.deal)} · ${c.deal}/100</span>
    </div>`;
  }).join('');
}

// CHAT
const aiReplies = {
  default: (q) => {
    const lower = q.toLowerCase();
    const found = coupons.find(c => lower.includes(c.brand.toLowerCase()) || lower.includes(c.code.toLowerCase()));
    if (found) return generateCouponAnalysis(found);
    if (lower.includes('best') || lower.includes('recommend')) return `📊 Based on current demand, the **Zomato ZOM200** (94/100) and **Swiggy SWIG300** (88/100) are your top picks right now. Both have no minimum order or low minimums respectively, and expiry is comfortably far. Want me to analyze any specific coupon?`;
    if (lower.includes('fake') || lower.includes('fraud') || lower.includes('safe')) return `🛡️ Every coupon on CouponX is validated through our 3-layer system:\n1. AI pre-screening on listing\n2. Real-time API check with partner platforms\n3. OTP-based escrow transfer\n\nOur AI fraud detection runs 24/7, catching 98% of fake listings before they go live.`;
    if (lower.includes('sell') || lower.includes('list')) return `💰 To list a coupon, head to the Sell section. Our AI will:\n• Validate the code in real-time\n• Score its demand & usability\n• Set a dynamic fair price\n• Escrow the buyer's payment\n\nMost listings go live in under 2 minutes!`;
    if (lower.includes('escrow') || lower.includes('payment') || lower.includes('safe')) return `🔒 Here's how escrow works:\n1. Buyer pays — funds go to CouponX escrow\n2. AI validates the coupon is live\n3. OTP transfer to buyer\n4. Seller receives payment\n\nNo one gets scammed. Both parties are protected.`;
    return `I can analyse any coupon for you! Try asking:\n• "Is the Amazon coupon worth it?"\n• "What's the deal score for Swiggy?"\n• "Which food coupon is best?"\n• "Is SWIG300 a good deal?"`;
  }
};

function generateCouponAnalysis(c) {
  const days = getDaysLeft(c.expiry);
  const savingPct = Math.round(((c.faceVal - c.salePrice) / c.faceVal) * 100);
  return `📊 **${c.brand} Analysis — ${c.code}**\n\n💰 You pay ₹${c.salePrice} for ₹${c.faceVal} value → **${savingPct}% saving**\n\n⏱ ${days} days until expiry ${days <= 5 ? '⚠️ Expiring soon!' : '✅ Comfortable window'}\n\n🎯 **Deal Score: ${c.deal}/100** — ${getDealLabel(c.deal)}\n\n${c.deal >= 80 ? '✅ Our AI recommends buying this. High demand category, fair pricing, and ample time to use it.' : c.deal >= 60 ? '👍 Decent deal. Check if you genuinely need it — the savings justify the price at current demand levels.' : '⚠️ Weaker deal. Expiry is close or conditions are restrictive. Buy only if you can use it soon.'}\n\nMin. order: ${c.minOrder > 0 ? '₹' + c.minOrder : 'No minimum — great!'}`;
}

function loadCouponInChat(id) {
  const c = coupons.find(x => x.id === id);
  addMessage(`Tell me about the ${c.brand} coupon — code ${c.code}`, 'user');
  setTimeout(() => {
    addMessage(generateCouponAnalysis(c), 'ai');
  }, 800);
}

function addMessage(text, role) {
  const box = document.getElementById('chatMessages');
  const isAI = role === 'ai';

  if (isAI) {
    const typingDiv = document.createElement('div');
    typingDiv.className = 'msg ai';
    typingDiv.id = 'typing';
    typingDiv.innerHTML = `<div class="msg-avatar ai">🤖</div><div class="msg-bubble"><div class="typing"><span></span><span></span><span></span></div></div>`;
    box.appendChild(typingDiv);
    box.scrollTop = box.scrollHeight;
    setTimeout(() => {
      document.getElementById('typing')?.remove();
      appendMsg(box, text, isAI);
    }, 900);
  } else {
    appendMsg(box, text, isAI);
  }
}

function appendMsg(box, text, isAI) {
  const div = document.createElement('div');
  div.className = `msg ${isAI ? 'ai' : 'user'}`;
  const formatted = text.replace(/\n/g, '<br>').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
  div.innerHTML = `<div class="msg-avatar ${isAI ? 'ai' : 'user'}">${isAI ? '🤖' : '👤'}</div><div class="msg-bubble">${formatted}</div>`;
  box.appendChild(div);
  box.scrollTop = box.scrollHeight;
}

function sendMessage() {
  const input = document.getElementById('chatInput');
  const val = input.value.trim();
  if (!val) return;
  addMessage(val, 'user');
  input.value = '';
  setTimeout(() => {
    addMessage(aiReplies.default(val), 'ai');
  }, 200);
}

// Sell form
function submitCoupon() {
  const brand = document.getElementById('sf-brand').value;
  const code = document.getElementById('sf-code').value;
  const val = document.getElementById('sf-value').value;
  if (!brand || !code || !val) { showToast('Please fill all required fields'); return; }

  const btn = document.querySelector('.submit-btn');
  btn.textContent = '🤖 AI Validating...';
  btn.disabled = true;

  setTimeout(() => {
    btn.textContent = '✅ Listed Successfully!';
    showToast(`🎉 "${brand} — ${code}" is now live on the marketplace!`);
    setTimeout(() => {
      btn.textContent = '🤖 Validate & List Coupon →';
      btn.disabled = false;
    }, 3000);
  }, 2000);
}

function showToast(msg) {
  document.getElementById('toastMsg').textContent = msg;
  const t = document.getElementById('toast');
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 3500);
}

function scrollTo(id) {
  document.getElementById(id).scrollIntoView({ behavior: 'smooth' });
}

// Scroll fade
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
}, { threshold: 0.1 });
document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));

// Init
renderCoupons('all');
renderValuations();
</script>
</body>
</html>
