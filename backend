/* POST /api/payments/initiate */
exports.initiate = async (req, res) => {
  try {
    const { couponId } = req.body;
    if (!couponId) return res.status(400).json({ success: false, message: 'couponId required.' });

    const result = await escrow.initiate({ couponId, buyerId: req.user._id });
    res.json({ success: true, data: result });
  } catch (err) {
    logger.error('Payment initiate error', { err: err.message });
    res.status(400).json({ success: false, message: err.message });
  }
};

/* POST /api/payments/webhook  — called by JusPay */
exports.webhook = async (req, res) => {
  try {
    // Body is raw buffer for signature verification
    const raw  = req.body.toString();
    const sig  = req.headers['x-jp-signature'] || '';
    const secret = process.env.JUSPAY_WEBHOOK_SECRET || '';

    if (secret && !verifyHmac(raw, sig, secret)) {
      logger.warn('Invalid JusPay webhook signature');
      return res.status(401).json({ success: false, message: 'Bad signature.' });
    }

    const payload = JSON.parse(raw);
    const { event_name, content } = payload;
    logger.info('JusPay webhook', { event: event_name, order: content?.order?.order_id });

    if (['ORDER_SUCCEEDED', 'PAYMENT_AUTHORIZED', 'TRANSACTION_CREATED'].includes(event_name)) {
      const order = content.order;
      if (juspay.mapStatus(order.status) === 'captured') {
        await escrow.onPaymentSuccess({ orderId: order.order_id, paymentId: order.txn_id, raw: order });
      }
    } else if (['ORDER_FAILED', 'PAYMENT_DECLINED'].includes(event_name)) {
      const order = content.order;
      const txn   = await Transaction.findOne({ 'payment.orderId': order.order_id });
      if (txn && txn.status === 'payment_pending') {
        await Coupon.findByIdAndUpdate(txn.coupon, { status: 'active' });
        txn.payment.status = 'failed';
        txn.status = 'failed';
        txn.notes.push({ msg: `Payment failed: ${order.error_message || 'Unknown'}` });
        await txn.save();
      }
    }

    res.json({ success: true }); // Always 200 to JusPay
  } catch (err) {
    logger.error('Webhook error', { err: err.message });
    res.json({ success: true }); // Still 200 to prevent retries
  }
};

/* POST /api/payments/verify-otp */
exports.verifyOTP = async (req, res) => {
  try {
    const { txnId, otp } = req.body;
    if (!txnId || !otp) return res.status(400).json({ success: false, message: 'txnId and otp required.' });

    const result = await escrow.verifyOTP({ txnId, buyerId: req.user._id, otp: String(otp).trim() });
    res.json({ success: true, data: result });
  } catch (err) {
    logger.error('OTP verify error', { err: err.message });
    res.status(400).json({ success: false, message: err.message });
  }
};

