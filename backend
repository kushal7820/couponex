const rateLimit   = require('express-rate-limit');
const helmet      = require('helmet');
const mongoSanitize = require('express-mongo-sanitize');
const hpp         = require('hpp');
const xss         = require('xss');
const logger      = require('../utils/logger');

/* ── Helmet ────────────────────────────────────────────────── */
const helmetMw = helmet({
  contentSecurityPolicy: {
    directives: {
      defaultSrc:  ["'self'"],
      scriptSrc:   ["'self'"],
      styleSrc:    ["'self'", "'unsafe-inline'", "fonts.googleapis.com"],
      fontSrc:     ["'self'", "fonts.gstatic.com"],
      imgSrc:      ["'self'", "data:", "https:"],
      connectSrc:  ["'self'", "https://sandbox.juspay.in", "https://api.anthropic.com"],
      frameSrc:    ["'self'", "https://sandbox.juspay.in"]
    }
  },
  crossOriginEmbedderPolicy: false
});

/* ── Rate Limiters ─────────────────────────────────────────── */
const makeLimit = (windowMs, max, msg) => rateLimit({
  windowMs, max, standardHeaders: true, legacyHeaders: false,
  handler: (req, res) => {
    logger.warn(`Rate limit hit: ${req.ip} → ${req.originalUrl}`);
    res.status(429).json({ success: false, message: msg });
  }
});

const globalLimit   = makeLimit(15 * 60 * 1000, 300, 'Too many requests. Please slow down.');
const authLimit     = makeLimit(15 * 60 * 1000, 10,  'Too many login attempts. Try again in 15 min.');
const paymentLimit  = makeLimit(60 * 60 * 1000, 20,  'Too many payment attempts. Try again later.');
const chatLimit     = makeLimit(60 * 1000,       30,  'Too many messages. Please wait a moment.');
const couponLimit   = makeLimit(60 * 60 * 1000, 15,  'Too many listings. Try again later.');

/* ── XSS sanitizer ─────────────────────────────────────────── */
const sanitizeXSS = (req, _, next) => {
  const clean = (obj) => {
    if (!obj || typeof obj !== 'object') return;
    for (const k of Object.keys(obj)) {
      if (typeof obj[k] === 'string') obj[k] = xss(obj[k]);
      else if (typeof obj[k] === 'object') clean(obj[k]);
    }
  };
  clean(req.body);
  clean(req.query);
  next();
};

/* ── Request logger ────────────────────────────────────────── */
const reqLogger = (req, res, next) => {
  const t = Date.now();
  res.on('finish', () => {
    const ms = Date.now() - t;
    const lvl = res.statusCode >= 500 ? 'error' : res.statusCode >= 400 ? 'warn' : 'info';
    logger[lvl](`${req.method} ${req.originalUrl} ${res.statusCode} ${ms}ms`, { ip: req.ip, user: req.user?.id });
  });
  next();
};

module.exports = {
  helmetMw, globalLimit, authLimit, paymentLimit, chatLimit, couponLimit,
  mongoSanitize: mongoSanitize({ replaceWith: '_' }),
  hpp: hpp(),
  sanitizeXSS,
  reqLogger
};

const jwt  = require('jsonwebtoken');
const User = require('../models/User');
const logger = require('../utils/logger');

const protect = async (req, res, next) => {
  try {
    const token = req.headers.authorization?.startsWith('Bearer ')
      ? req.headers.authorization.split(' ')[1]
      : req.cookies?.jwt;

    if (!token) return res.status(401).json({ success: false, message: 'Not authenticated. Please log in.' });

    let decoded;
    try {
      decoded = jwt.verify(token, process.env.JWT_SECRET);
    } catch (e) {
      if (e.name === 'TokenExpiredError')
        return res.status(401).json({ success: false, code: 'TOKEN_EXPIRED', message: 'Session expired. Please log in again.' });
      return res.status(401).json({ success: false, message: 'Invalid token.' });
    }

    const user = await User.findById(decoded.id);
    if (!user)          return res.status(401).json({ success: false, message: 'User no longer exists.' });
    if (!user.isActive) return res.status(403).json({ success: false, message: 'Account deactivated.' });
    if (user.isLocked()) return res.status(423).json({ success: false, message: 'Account temporarily locked.' });
    if (user.passwordChangedAfter(decoded.iat))
      return res.status(401).json({ success: false, message: 'Password changed. Please log in again.' });

    req.user = user;
    next();
  } catch (err) {
    logger.error('Auth middleware error', { err: err.message });
    res.status(500).json({ success: false, message: 'Authentication error.' });
  }
};

const restrictTo = (...roles) => (req, res, next) => {
  if (!roles.includes(req.user.role))
    return res.status(403).json({ success: false, message: 'You do not have permission for this action.' });
  next();
};

const optionalAuth = async (req, _, next) => {
  try {
    const token = req.headers.authorization?.split(' ')[1];
    if (token) {
      const decoded = jwt.verify(token, process.env.JWT_SECRET);
      req.user = await User.findById(decoded.id);
    }
  } catch {}
  next();
};

module.exports = { protect, restrictTo, optionalAuth };

/**
 * JusPay Payment Gateway Integration
 * Docs: https://developer.juspay.in/docs
 * Sandbox: https://sandbox.juspay.in
 *
 * Free sandbox account: https://dashboard.juspay.in/register
 */
const axios = require('axios');
const logger = require('../utils/logger');

const BASE   = process.env.JUSPAY_BASE_URL || 'https://sandbox.juspay.in';
const MID    = process.env.JUSPAY_MERCHANT_ID || 'sandbox_merchant';
const APIKEY = process.env.JUSPAY_API_KEY    || 'sandbox_key';

const auth = () => `Basic ${Buffer.from(`${APIKEY}:`).toString('base64')}`;
const headers = () => ({
  Authorization: auth(),
  'Content-Type': 'application/json',
  'x-merchantid': MID,
  version: '2023-12-01'
});

/**
 * Create a JusPay hosted payment session.
 * Returns a paymentUrl the buyer opens to complete payment.
 */
const createSession = async ({ orderId, amount, customerId, email, phone, returnUrl, description }) => {
  try {
    const payload = {
      merchant_id: MID,
      order_id: orderId,
      amount: Number(amount).toFixed(2),
      customer_id: customerId,
      customer_email: email,
      customer_phone: phone || '9999999999',
      payment_page_client_id: MID,
      action: 'paymentPage',
      return_url: returnUrl,
      description: description || 'CouponX Purchase',
      currency: 'INR'
    };

    const { data } = await axios.post(`${BASE}/session`, payload, { headers: headers(), timeout: 12000 });

    logger.info('JusPay session created', { orderId, amount });
    return {
      ok: true,
      paymentUrl: data.payment_links?.web || `${BASE}/merchant/pay/${data.id}`,
      sessionId: data.id,
      orderId: data.order_id
    };
  } catch (err) {
    logger.error('JusPay createSession failed', { orderId, error: err.response?.data || err.message });
    throw new Error(err.response?.data?.error_message || 'Payment session creation failed');
  }
};

/**
 * Fetch order status from JusPay.
 */
const getOrderStatus = async (orderId) => {
  try {
    const { data } = await axios.get(`${BASE}/orders/${orderId}`, { headers: headers(), timeout: 10000 });
    return {
      ok: true,
      orderId: data.order_id,
      status: data.status,         // CHARGED | PENDING | FAILED | COD_INITIATED
      amount: data.amount,
      txnId: data.txn_id,
      method: data.payment_method,
      raw: data
    };
  } catch (err) {
    logger.error('JusPay getOrderStatus failed', { orderId, error: err.message });
    throw new Error('Failed to fetch payment status');
  }
};

/**
 * Initiate a refund via JusPay.
 * Called automatically when coupon validation fails.
 */
const refund = async ({ orderId, amount, refundId, reason }) => {
  try {
    const payload = {
      unique_request_id: refundId,
      amount: Number(amount).toFixed(2),
      order_id: orderId
    };

    const { data } = await axios.post(`${BASE}/orders/${orderId}/refunds`, payload, {
      headers: headers(), timeout: 12000
    });

    logger.info('JusPay refund initiated', { orderId, refundId, amount });
    return { ok: true, refundId: data.id, status: data.status, raw: data };
  } catch (err) {
    logger.error('JusPay refund failed', { orderId, error: err.response?.data || err.message });
    throw new Error(err.response?.data?.error_message || 'Refund initiation failed');
  }
};

/**
 * Map JusPay status strings to our internal payment status.
 */
const mapStatus = (s) => ({
  CHARGED:                'captured',
  PENDING:                'processing',
  PENDING_VBV:            'processing',
  AUTHORIZING:            'processing',
  STARTED:                'processing',
  AUTHORIZATION_FAILED:   'failed',
  AUTHENTICATION_FAILED:  'failed',
  JUSPAY_DECLINED:        'failed',
  COD_INITIATED:          'pending',
  VOID_INITIATED:         'cancelled',
  VOIDED:                 'cancelled'
}[s] || 'pending');

module.exports = { createSession, getOrderStatus, refund, mapStatus };

/**
 * Escrow Service
 * ─────────────────────────────────────────────────────────────────
 * Flow:
 *  1. initiate()        → reserve coupon, create txn, get JusPay URL
 *  2. onPaymentSuccess()→ money in escrow, start coupon validation
 *  3. validate()        → check coupon is real + unused
 *  4. sendOTP()         → OTP generated, sent to buyer
 *  5. verifyOTP()       → OTP correct → decrypt code, release to seller
 *
 * On any failure in steps 3-5: abortAndRefund() → auto refund buyer
 * ─────────────────────────────────────────────────────────────────
 */
const { v4: uuidv4 } = require('uuid');
const Transaction = require('../models/Transaction');
const Coupon      = require('../models/Coupon');
const User        = require('../models/User');
const juspay      = require('./juspay');
const { generateOTP, hashOTP, decryptCoupon } = require('../utils/encryption');
const logger      = require('../utils/logger');

const PLATFORM_FEE_PCT = 5; // 5% platform fee

/* ─── 1. Initiate Purchase ─────────────────────────────────── */
const initiate = async ({ couponId, buyerId }) => {
  const coupon = await Coupon.findById(couponId);
  if (!coupon)                      throw new Error('Coupon not found');
  if (coupon.status !== 'active')   throw new Error('Coupon is not available');
  if (coupon.expiryDate < new Date()) throw new Error('Coupon has expired');
  if (String(coupon.seller) === String(buyerId)) throw new Error('You cannot buy your own coupon');

  const buyer = await User.findById(buyerId);
  if (!buyer?.isActive) throw new Error('Buyer account is invalid');

  const fee      = Math.round(coupon.salePrice * PLATFORM_FEE_PCT / 100);
  const payout   = coupon.salePrice - fee;
  const txnId    = `TXN-${Date.now()}-${uuidv4().slice(0,6).toUpperCase()}`;
  const orderId  = `ORD-${Date.now()}-${uuidv4().slice(0,6).toUpperCase()}`;

  // Reserve coupon so no one else can buy it
  await Coupon.findByIdAndUpdate(couponId, { status: 'reserved' });

  // Create transaction record
  const txn = await Transaction.create({
    txnId,
    coupon:       couponId,
    buyer:        buyerId,
    seller:       coupon.seller,
    amount:       coupon.salePrice,
    platformFee:  fee,
    sellerPayout: payout,
    'payment.orderId': orderId,
    status:       'payment_pending',
    'escrow.status': 'awaiting_payment',
    notes: [{ msg: 'Purchase initiated' }]
  });

  // Create JusPay session
  const session = await juspay.createSession({
    orderId,
    amount:      coupon.salePrice,
    customerId:  String(buyerId),
    email:       buyer.email,
    phone:       buyer.phone || '9999999999',
    returnUrl:   `${process.env.FRONTEND_URL}/payment/callback?txn=${txnId}`,
    description: `CouponX: ${coupon.brand} — ${coupon.description.slice(0, 60)}`
  });

  logger.info('Escrow initiated', { txnId, couponId, buyerId });

  return {
    txnId,
    orderId,
    paymentUrl: session.paymentUrl,
    amount: coupon.salePrice,
    coupon: {
      brand:      coupon.brand,
      description: coupon.description,
      maskedCode: coupon.maskedCode,   // ← only masked code, never real
      faceValue:  coupon.faceValue,
      expiryDate: coupon.expiryDate
    }
  };
};

/* ─── 2. Payment Confirmed (webhook / poll) ────────────────── */
const onPaymentSuccess = async ({ orderId, paymentId, raw }) => {
  const txn = await Transaction.findOne({ 'payment.orderId': orderId });
  if (!txn) throw new Error(`No transaction for order ${orderId}`);
  if (txn.escrow.status !== 'awaiting_payment') {
    logger.warn('Duplicate payment event ignored', { orderId });
    return txn;
  }

  txn.payment.status    = 'captured';
  txn.payment.paymentId = paymentId;
  txn.payment.paidAt    = new Date();
  txn.payment.raw       = raw;
  txn.escrow.status     = 'payment_received';
  txn.escrow.heldAt     = new Date();
  txn.status            = 'in_escrow';
  txn.notes.push({ msg: 'Payment captured — held in escrow' });
  await txn.save();

  // Kick off validation asynchronously
  validate(txn._id).catch(err => logger.error('Validation error', { txnId: txn.txnId, err: err.message }));
  return txn;
};

/* ─── 3. Validate Coupon ───────────────────────────────────── */
const validate = async (txnMongoId) => {
  const txn = await Transaction.findById(txnMongoId).populate('coupon');
  if (!txn) throw new Error('Transaction not found');

  txn.escrow.status        = 'validating';
  txn.validation.status    = 'in_progress';
  txn.validation.attempts += 1;
  txn.notes.push({ msg: 'Coupon validation started' });
  await txn.save();

  // ── Validation checks ─────────────────────────────────────
  const coupon = await Coupon.findById(txn.coupon._id);

  if (!coupon) {
    return abortAndRefund(txn._id, 'Coupon no longer exists');
  }
  if (coupon.expiryDate < new Date()) {
    return abortAndRefund(txn._id, 'Coupon expired during transaction');
  }
  if (coupon.status !== 'reserved') {
    return abortAndRefund(txn._id, 'Coupon is no longer available');
  }

  // ── Validation passed: generate OTP ───────────────────────
  const otp     = generateOTP(6);
  const otpHash = hashOTP(otp);
  const otpExp  = new Date(Date.now() + (parseInt(process.env.OTP_EXPIRY_MINUTES) || 10) * 60000);

  await Coupon.findByIdAndUpdate(coupon._id, {
    'otp.hash':      otpHash,
    'otp.expiresAt': otpExp,
    'otp.attempts':  0
  });

  txn.validation.status  = 'passed';
  txn.validation.doneAt  = new Date();
  txn.escrow.status      = 'otp_pending';
  txn.notes.push({ msg: `Validation passed. OTP generated: ${otp} (dev-visible only)` });
  await txn.save();

  logger.info('Coupon validated, OTP ready', { txnId: txn.txnId, otp /* remove in prod */ });

  // TODO: SMS/email OTP to buyer via Twilio / AWS SNS
  // await smsService.send(buyer.phone, `Your CouponX OTP: ${otp}. Valid for 10 min.`);
};

/* ─── 4+5. Verify OTP → Reveal Code → Release Escrow ──────── */
const verifyOTP = async ({ txnId, buyerId, otp }) => {
  const txn = await Transaction.findOne({ txnId });
  if (!txn)                                     throw new Error('Transaction not found');
  if (String(txn.buyer) !== String(buyerId))    throw new Error('Unauthorized');
  if (txn.escrow.status !== 'otp_pending')      throw new Error('OTP not expected at this stage');

  // Fetch coupon with encrypted code + otp (both select: false)
  const coupon = await Coupon.findById(txn.coupon).select('+encryptedCode +otp');
  if (!coupon) throw new Error('Coupon not found');

  // Max attempts guard
  if (coupon.otp.attempts >= 3) {
    await abortAndRefund(txn._id, 'Too many incorrect OTP attempts');
    throw new Error('Too many OTP attempts. Your payment has been refunded.');
  }

  // Expiry check
  if (coupon.otp.expiresAt < new Date()) {
    await abortAndRefund(txn._id, 'OTP expired without verification');
    throw new Error('OTP expired. Your payment has been refunded.');
  }

  // Verify
  const expected = hashOTP(String(otp).trim());
  if (coupon.otp.hash !== expected) {
    await Coupon.findByIdAndUpdate(coupon._id, { $inc: { 'otp.attempts': 1 } });
    const left = 3 - (coupon.otp.attempts + 1);
    throw new Error(`Incorrect OTP. ${left} attempt(s) remaining.`);
  }

  // ── SUCCESS: decrypt code ──────────────────────────────────
  const realCode = decryptCoupon(coupon.encryptedCode);

  // Mark coupon sold
  await Coupon.findByIdAndUpdate(coupon._id, {
    status:       'sold',
    buyer:        buyerId,
    soldAt:       new Date(),
    'otp.hash':   null
  });

  // Release escrow
  txn.escrow.status     = 'released';
  txn.escrow.releasedAt = new Date();
  txn.status            = 'completed';
  txn.completedAt       = new Date();
  txn.notes.push({ msg: 'OTP verified. Escrow released to seller.' });
  await txn.save();

  // Credit seller wallet
  await User.findByIdAndUpdate(txn.seller, {
    $inc: { 'wallet.balance': txn.sellerPayout, totalTransactions: 1, successfulTransactions: 1 }
  });
  await User.findByIdAndUpdate(txn.buyer, {
    $inc: { totalTransactions: 1, successfulTransactions: 1 }
  });

  logger.info('Escrow released, coupon delivered', { txnId });

  return {
    success:   true,
    couponCode: realCode,      // ← First and only time the real code is returned
    brand:     coupon.brand,
    expiryDate: coupon.expiryDate,
    terms:     coupon.terms
  };
};

/* ─── Abort + Auto-Refund ──────────────────────────────────── */
const abortAndRefund = async (txnMongoId, reason) => {
  const txn = await Transaction.findById(txnMongoId);
  if (!txn) return;

  logger.warn('Escrow abort initiated', { txnId: txn.txnId, reason });

  // Release coupon back to active
  await Coupon.findByIdAndUpdate(txn.coupon, { status: 'active', buyer: null });

  // Trigger JusPay refund if payment was captured
  let refundResult = null;
  if (txn.payment.orderId && txn.payment.status === 'captured') {
    try {
      refundResult = await juspay.refund({
        orderId:  txn.payment.orderId,
        amount:   txn.amount,
        refundId: `REF-${txn.txnId}`,
        reason
      });
      txn.payment.refundId    = refundResult.refundId;
      txn.payment.refundedAt  = new Date();
      txn.payment.refundReason = reason;
      txn.payment.status      = 'refunded';
    } catch (refErr) {
      logger.error('Auto-refund failed — manual action required', { txnId: txn.txnId, err: refErr.message });
      txn.notes.push({ msg: `⚠️ MANUAL REFUND NEEDED: ${refErr.message}` });
    }
  }

  txn.escrow.status     = 'aborted';
  txn.escrow.abortedAt  = new Date();
  txn.escrow.abortReason = reason;
  txn.status            = 'refunded';
  txn.validation.status = 'failed';
  txn.validation.failReason = reason;
  txn.notes.push({ msg: `Aborted: ${reason}` });
  await txn.save();

  return { aborted: true, reason };
};

module.exports = { initiate, onPaymentSuccess, validate, verifyOTP, abortAndRefund };

const axios   = require('axios');
const logger  = require('../utils/logger');

const API_URL = 'https://api.anthropic.com/v1/messages';
const MODEL   = 'claude-sonnet-4-6';

const call = async (payload) => {
  const { data } = await axios.post(API_URL, { model: MODEL, max_tokens: 600, ...payload }, {
    headers: {
      'x-api-key': process.env.ANTHROPIC_API_KEY,
      'anthropic-version': '2023-06-01',
      'Content-Type': 'application/json'
    },
    timeout: 20000
  });
  return data.content[0].text.trim();
};

/* ── Coupon AI Scoring ─────────────────────────────────────── */
const scoreCoupon = async ({ brand, category, description, faceValue, salePrice, minOrder, expiryDate }) => {
  const daysLeft  = Math.ceil((new Date(expiryDate) - Date.now()) / 86400000);
  const savingPct = Math.round(((faceValue - salePrice) / faceValue) * 100);

  const prompt = `You are a coupon fraud detection and valuation AI for an Indian marketplace.
Analyze this coupon and respond ONLY with valid JSON — no markdown, no extra text.

Brand: ${brand}
Category: ${category}
Description: ${description}
Face Value: ₹${faceValue}
Sale Price: ₹${salePrice}
Savings: ${savingPct}%
Min Order: ₹${minOrder || 0}
Days Left: ${daysLeft}

JSON schema:
{
  "score": <0-100 integer>,
  "rating": "<hot|good|weak>",
  "fraudRisk": "<low|medium|high>",
  "flags": [<string reasons if any>],
  "recommendation": "<one sentence>",
  "analysis": "<2-3 sentences>",
  "suggestedPrice": <fair integer price in INR>
}`;

  try {
    const text   = await call({ messages: [{ role: 'user', content: prompt }] });
    const clean  = text.replace(/```json|```/g, '').trim();
    return JSON.parse(clean);
  } catch (err) {
    logger.warn('AI scoring fallback used', { err: err.message });
    return fallbackScore(daysLeft, savingPct, minOrder, faceValue);
  }
};

const fallbackScore = (daysLeft, savingPct, minOrder, faceValue) => {
  let score = 50;
  if (savingPct > 70) score += 25; else if (savingPct > 50) score += 15; else if (savingPct > 30) score += 8;
  if (daysLeft > 30) score += 15; else if (daysLeft > 14) score += 8; else if (daysLeft < 5) score -= 15;
  if (!minOrder) score += 10; else if (minOrder < faceValue * 2) score += 5;
  score = Math.min(100, Math.max(0, score));
  return {
    score, rating: score >= 75 ? 'hot' : score >= 55 ? 'good' : 'weak',
    fraudRisk: 'low', flags: [], recommendation: 'Auto-scored (AI unavailable).',
    analysis: `${savingPct}% savings with ${daysLeft} days remaining.`,
    suggestedPrice: Math.round(faceValue * 0.4)
  };
};

/* ── Customer Support Chatbot ──────────────────────────────── */
const SYSTEM = `You are CouponX Support — a helpful, concise, friendly support agent.

PLATFORM FACTS:
• CouponX is a peer-to-peer coupon marketplace in India
• Buyers purchase verified coupons at discounted prices; sellers monetise unused coupons
• All transactions use escrow: buyer pays → money held → coupon validated → OTP sent → buyer enters OTP → code revealed → seller paid
• Coupon codes are AES-256 encrypted and NEVER shown until OTP verification succeeds
• If coupon validation fails or too many wrong OTPs: payment is AUTOMATICALLY refunded (3-5 business days)
• Platform fee: 5% (charged to seller)
• OTP expires in 10 minutes, max 3 attempts

RULES:
• Be concise and helpful
• If you cannot resolve an account/technical issue, say "I'll escalate this — expect a reply within 2 hours"
• Never reveal internal implementation details`;

const chat = async ({ message, history = [], userCtx = null }) => {
  const messages = [
    ...history.slice(-12).map(m => ({ role: m.role, content: m.content })),
    { role: 'user', content: message }
  ];

  const extra = userCtx ? `\n\nUser context: name=${userCtx.name}, role=${userCtx.role}` : '';

  try {
    const reply = await call({ system: SYSTEM + extra, messages });
    return { role: 'assistant', content: reply };
  } catch (err) {
    logger.error('Chatbot error', { err: err.message });
    return { role: 'assistant', content: "I'm having trouble right now. For urgent help, email support@couponx.in 🙏" };
  }
};

module.exports = { scoreCoupon, chat };

const mongoose = require('mongoose');

const noteSchema = new mongoose.Schema({
  msg: String,
  by:  { type: String, default: 'system' },
  at:  { type: Date, default: Date.now }
}, { _id: false });

const transactionSchema = new mongoose.Schema({
  txnId:  { type: String, required: true, unique: true },
  coupon: { type: mongoose.Schema.Types.ObjectId, ref: 'Coupon', required: true },
  buyer:  { type: mongoose.Schema.Types.ObjectId, ref: 'User',   required: true },
  seller: { type: mongoose.Schema.Types.ObjectId, ref: 'User',   required: true },

  amount:          { type: Number, required: true },
  platformFee:     { type: Number, default: 0 },
  sellerPayout:    { type: Number, required: true },

  // JusPay payment details
  payment: {
    orderId:   String,
    sessionId: String,
    paymentId: String,
    method:    String,
    status: {
      type: String,
      enum: ['pending','processing','captured','failed','refunded','cancelled'],
      default: 'pending'
    },
    paidAt:       Date,
    refundId:     String,
    refundedAt:   Date,
    refundReason: String,
    raw:          mongoose.Schema.Types.Mixed
  },

  // Escrow lifecycle
  escrow: {
    status: {
      type: String,
      enum: [
        'awaiting_payment',   // Buyer hasn't paid yet
        'payment_received',   // Money captured, held in escrow
        'validating',         // Coupon being validated
        'otp_pending',        // OTP sent to buyer
        'released',           // Escrow released to seller ✅
        'aborted',            // Validation failed → refund triggered
        'disputed'            // Dispute raised
      ],
      default: 'awaiting_payment'
    },
    heldAt:       Date,
    releasedAt:   Date,
    abortedAt:    Date,
    abortReason:  String
  },

  // Coupon validation result
  validation: {
    status:    { type: String, enum: ['not_started','in_progress','passed','failed'], default: 'not_started' },
    failReason: String,
    doneAt:    Date,
    attempts:  { type: Number, default: 0 }
  },

  // Overall transaction status
  status: {
    type: String,
    enum: ['initiated','payment_pending','in_escrow','completed','failed','refunded','disputed'],
    default: 'initiated'
  },

  completedAt: Date,
  notes:       [noteSchema],

  // Post-transaction ratings
  buyerRating:  { score: Number, comment: String, at: Date },
  sellerRating: { score: Number, comment: String, at: Date }
}, { timestamps: true });

transactionSchema.index({ txnId: 1 });
transactionSchema.index({ buyer: 1, status: 1 });
transactionSchema.index({ seller: 1, status: 1 });
transactionSchema.index({ 'payment.orderId': 1 });

module.exports = mongoose.model('Transaction', transactionSchema);

const mongoose = require('mongoose');
const bcrypt = require('bcryptjs');

const userSchema = new mongoose.Schema({
  name:     { type: String, required: true, trim: true, maxlength: 60 },
  email:    { type: String, required: true, unique: true, lowercase: true, match: [/^\S+@\S+\.\S+$/, 'Invalid email'] },
  password: { type: String, required: true, minlength: 8, select: false },
  phone:    { type: String, default: '' },
  role:     { type: String, enum: ['buyer', 'seller', 'admin'], default: 'buyer' },

  isActive:   { type: Boolean, default: true },
  isVerified: { type: Boolean, default: false },

  trustScore:             { type: Number, default: 100, min: 0, max: 100 },
  totalTransactions:      { type: Number, default: 0 },
  successfulTransactions: { type: Number, default: 0 },

  wallet: {
    balance:       { type: Number, default: 0 },
    escrowBalance: { type: Number, default: 0 }
  },

  // Security
  loginAttempts:    { type: Number, default: 0 },
  lockUntil:        { type: Date },
  refreshToken:     { type: String, select: false },
  passwordChanged:  { type: Date },
  lastLogin:        { type: Date }
}, { timestamps: true });

// Hash password
userSchema.pre('save', async function (next) {
  if (!this.isModified('password')) return next();
  this.password = await bcrypt.hash(this.password, 12);
  this.passwordChanged = new Date();
  next();
});

userSchema.methods.matchPassword = async function (plain) {
  return bcrypt.compare(plain, this.password);
};

userSchema.methods.isLocked = function () {
  return this.lockUntil && this.lockUntil > Date.now();
};

userSchema.methods.incAttempts = async function () {
  if (this.lockUntil && this.lockUntil < Date.now()) {
    return this.updateOne({ $set: { loginAttempts: 1 }, $unset: { lockUntil: 1 } });
  }
  const updates = { $inc: { loginAttempts: 1 } };
  if (this.loginAttempts + 1 >= 5) {
    updates.$set = { lockUntil: Date.now() + 2 * 60 * 60 * 1000 }; // 2 hr lock
  }
  return this.updateOne(updates);
};

userSchema.methods.passwordChangedAfter = function (jwtIat) {
  if (this.passwordChanged) {
    return Math.floor(this.passwordChanged.getTime() / 1000) > jwtIat;
  }
  return false;
};

userSchema.virtual('successRate').get(function () {
  return this.totalTransactions === 0 ? 100
    : Math.round((this.successfulTransactions / this.totalTransactions) * 100);
});

userSchema.set('toJSON', { virtuals: true });

module.exports = mongoose.model('User', userSchema);

const mongoose = require('mongoose');

const couponSchema = new mongoose.Schema({
  seller:      { type: mongoose.Schema.Types.ObjectId, ref: 'User', required: true },
  buyer:       { type: mongoose.Schema.Types.ObjectId, ref: 'User', default: null },

  brand:       { type: String, required: true, trim: true, maxlength: 100 },
  category:    { type: String, required: true, enum: ['food','shopping','travel','health','entertainment','other'] },
  description: { type: String, required: true, maxlength: 500 },

  // AES-256 encrypted — NEVER returned in API responses until escrow released
  encryptedCode: { type: String, required: true, select: false },
  // Shown to buyers before purchase (e.g. "SAV*****")
  maskedCode:    { type: String, required: true },

  faceValue:    { type: Number, required: true, min: 1 },
  salePrice:    { type: Number, required: true, min: 1 },
  minOrder:     { type: Number, default: 0 },
  expiryDate:   { type: Date, required: true },
  terms:        { type: String, maxlength: 1000, default: '' },
  applicableOn: { type: String, maxlength: 200, default: '' },

  status: {
    type: String,
    enum: ['pending_review', 'active', 'reserved', 'sold', 'expired', 'flagged', 'removed'],
    default: 'pending_review'
  },

  // AI scoring
  ai: {
    score:      { type: Number, min: 0, max: 100, default: null },
    rating:     { type: String, enum: ['hot','good','weak','unrated'], default: 'unrated' },
    fraudRisk:  { type: String, enum: ['low','medium','high'], default: 'low' },
    flags:      [String],
    scoredAt:   Date
  },

  // OTP for transfer — stored hashed, selected explicitly
  otp: {
    hash:      { type: String, select: false },
    expiresAt: { type: Date },
    attempts:  { type: Number, default: 0 }
  },

  views:       { type: Number, default: 0 },
  soldAt:      { type: Date }
}, { timestamps: true });

couponSchema.virtual('daysLeft').get(function () {
  return Math.ceil((this.expiryDate - Date.now()) / 86400000);
});
couponSchema.virtual('savingPct').get(function () {
  return Math.round(((this.faceValue - this.salePrice) / this.faceValue) * 100);
});

couponSchema.set('toJSON', { virtuals: true });
couponSchema.set('toObject', { virtuals: true });

couponSchema.index({ status: 1, category: 1 });
couponSchema.index({ seller: 1 });
couponSchema.index({ expiryDate: 1 });
couponSchema.index({ brand: 'text', description: 'text' });

module.exports = mongoose.model('Coupon', couponSchema);

require('dotenv').config();
const express = require('express');
const cors    = require('cors');
const cron    = require('node-cron');

const connectDB = require('./config/db');
const routes    = require('./routes/index');
const logger    = require('./utils/logger');
const {
  helmetMw, globalLimit, mongoSanitize, hpp,
  sanitizeXSS, reqLogger
} = require('./middleware/security');

const app = express();
connectDB();

/* ── Security ─────────────────────────────────────────────── */
app.use(helmetMw);
app.use(cors({
  origin: (process.env.FRONTEND_URL || 'http://localhost:3000').split(','),
  credentials: true,
  methods: ['GET','POST','PUT','DELETE','PATCH'],
  allowedHeaders: ['Content-Type','Authorization']
}));
app.use(globalLimit);
app.use(mongoSanitize);
app.use(hpp);
app.use(reqLogger);

/* ── Body Parsing ─────────────────────────────────────────── */
// Webhook route needs raw body BEFORE json parser
app.use('/api/payments/webhook', express.raw({ type: '*/*' }));
app.use(express.json({ limit: '10kb' }));
app.use(express.urlencoded({ extended: true, limit: '10kb' }));
app.use(sanitizeXSS);

/* ── Routes ───────────────────────────────────────────────── */
app.use('/api', routes);

/* ── 404 ──────────────────────────────────────────────────── */
app.use((req, res) => res.status(404).json({ success: false, message: `${req.originalUrl} not found` }));

/* ── Global Error Handler ─────────────────────────────────── */
app.use((err, req, res, next) => {
  logger.error('Unhandled', { msg: err.message, stack: err.stack });
  if (err.code === 11000) {
    const field = Object.keys(err.keyValue || {})[0] || 'field';
    return res.status(409).json({ success: false, message: `${field} already exists.` });
  }
  if (err.name === 'ValidationError') {
    const msgs = Object.values(err.errors).map(e => e.message);
    return res.status(400).json({ success: false, message: msgs.join('. ') });
  }
  res.status(err.statusCode || 500).json({
    success: false,
    message: process.env.NODE_ENV === 'production' ? 'Something went wrong.' : err.message
  });
});

/* ── Cron: expire coupons ─────────────────────────────────── */
cron.schedule('0 * * * *', async () => {
  try {
    const Coupon = require('./models/Coupon');
    const r = await Coupon.updateMany(
      { expiryDate: { $lt: new Date() }, status: { $in: ['active','pending_review'] } },
      { $set: { status: 'expired' } }
    );
    if (r.modifiedCount) logger.info(`Cron: expired ${r.modifiedCount} coupons`);
  } catch (e) { logger.error('Cron error', { e: e.message }); }
});

