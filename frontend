import React from 'react';
import { useNavigate } from 'react-router-dom';
import { useAuth } from '../context/AuthContext';
import toast from 'react-hot-toast';

const col = s => s >= 80 ? '#00e5a0' : s >= 60 ? '#f59e0b' : '#ef4444';
const lbl = s => s >= 80 ? '🔥 Hot Deal' : s >= 60 ? '👍 Good Deal' : '⚠️ Weak';

export default function CouponCard({ c, onBuy }) {
  const { user } = useAuth();
  const nav = useNavigate();
  const score  = c.ai?.score ?? 70;
  const color  = col(score);
  const days   = c.daysLeft ?? Math.ceil((new Date(c.expiryDate) - Date.now()) / 86400000);
  const savPct = c.savingPct ?? Math.round(((c.faceValue - c.salePrice) / c.faceValue) * 100);
  const urgent = days <= 5;

  const buy = () => {
    if (!user) { toast.error('Please login to buy'); nav('/login'); return; }
    if (user.role === 'seller') { toast.error('Switch to a buyer account to purchase'); return; }
    onBuy(c);
  };

  return (
    <div className="card" style={{ padding:0,overflow:'hidden',cursor:'default' }}
      onMouseEnter={e=>e.currentTarget.style.transform='translateY(-4px)'}
      onMouseLeave={e=>e.currentTarget.style.transform=''}>

      {/* Header */}
      <div style={{ padding:'1.1rem 1.3rem',borderBottom:'1px dashed rgba(255,255,255,.08)',
        background:'linear-gradient(135deg,var(--sur2),var(--sur))',
        display:'flex',justifyContent:'space-between',alignItems:'flex-start' }}>
        <div>
          <div style={{ fontFamily:'Syne,sans-serif',fontWeight:700,fontSize:'1rem' }}>{c.brand}</div>
          <div style={{ fontSize:'.68rem',color:'var(--mut)',marginTop:'.18rem',textTransform:'uppercase',letterSpacing:'.06em' }}>{c.category}</div>
        </div>
        <div style={{ background:`linear-gradient(135deg,${color},${color}88)`,color:'#000',
          fontWeight:800,fontSize:'.75rem',padding:'.28rem .6rem',borderRadius:7,whiteSpace:'nowrap' }}>
          {score}/100
        </div>
      </div>

      {/* Body */}
      <div style={{ padding:'1.1rem 1.3rem' }}>
        <p style={{ fontSize:'.83rem',color:'var(--mut)',marginBottom:'.9rem',lineHeight:1.55 }}>{c.description}</p>

        {/* Masked code */}
        <div style={{ fontFamily:'monospace',fontSize:'.95rem',fontWeight:700,
          background:'rgba(255,255,255,.04)',padding:'.45rem .8rem',
          borderRadius:8,border:'1px solid var(--bdr)',
          display:'flex',alignItems:'center',justifyContent:'space-between',marginBottom:'.85rem' }}>
          <span style={{ letterSpacing:'.08em' }}>{c.maskedCode}</span>
          <span style={{ fontSize:'.65rem',color:'var(--mut)' }}>🔒 Hidden</span>
        </div>

        {/* Deal bar */}
        <div style={{ marginBottom:'.85rem' }}>
          <div style={{ display:'flex',justifyContent:'space-between',marginBottom:'.28rem' }}>
            <span style={{ fontSize:'.7rem',color:'var(--mut)' }}>Deal Score</span>
            <span style={{ fontSize:'.7rem',fontWeight:700,color }}>{lbl(score)}</span>
          </div>
          <div className="db"><div className="df" style={{ width:`${score}%`,background:`linear-gradient(90deg,${color},${color}66)` }}/></div>
        </div>

        {/* Meta */}
        <div style={{ display:'flex',justifyContent:'space-between',fontSize:'.78rem',color:'var(--mut)',marginBottom:'.9rem' }}>
          <span>Min: {c.minOrder > 0 ? `₹${c.minOrder}` : 'None'}</span>
          <span style={{ color: urgent ? 'var(--err)' : 'var(--amb)', fontWeight:500, animation: urgent ? 'blink 1.4s ease infinite' : 'none' }}>
            ⏱ {days}d left
          </span>
        </div>

        {/* Price row */}
        <div style={{ display:'flex',justifyContent:'space-between',alignItems:'center' }}>
          <div>
            <div style={{ fontSize:'.75rem',color:'var(--mut)',textDecoration:'line-through' }}>₹{c.faceValue} value</div>
            <div style={{ fontFamily:'Syne,sans-serif',fontSize:'1.25rem',fontWeight:800,color:'var(--acc)' }}>
              ₹{c.salePrice} <span style={{ fontSize:'.68rem',color }}>{savPct}% off</span>
            </div>
          </div>
          <button className="btn btn-purple btn-sm" onClick={buy}>Buy Now →</button>
        </div>

        {/* Seller */}
        {c.seller && (
          <div style={{ marginTop:'.8rem',paddingTop:'.8rem',borderTop:'1px solid var(--bdr)',
            display:'flex',justifyContent:'space-between',fontSize:'.7rem',color:'var(--mut)' }}>
            <span>by {c.seller.name}</span>
            <span style={{ color:'var(--acc)' }}>⭐ {c.seller.trustScore}/100</span>
          </div>
        )}
      </div>
    </div>
  );
}

import React, { useState } from 'react';
import { Link, useNavigate, useLocation } from 'react-router-dom';
import { useAuth } from '../context/AuthContext';
import toast from 'react-hot-toast';

export default function Navbar() {
  const { user, logout } = useAuth();
  const nav = useNavigate();
  const loc = useLocation();
  const [open, setOpen] = useState(false);
  const active = p => loc.pathname === p;

  const doLogout = async () => { await logout(); toast.success('Logged out'); nav('/'); };

  const links = [
    { to: '/marketplace', label: 'Marketplace' },
    ...(user?.role === 'seller' || user?.role === 'admin' ? [{ to: '/sell', label: 'Sell' }] : []),
    ...(user ? [{ to: '/dashboard', label: 'Dashboard' }] : [])
  ];

  return (
    <nav style={{ position:'fixed',top:0,left:0,right:0,zIndex:200,height:64,
      background:'rgba(8,12,20,.92)',backdropFilter:'blur(20px)',
      borderBottom:'1px solid var(--bdr)',display:'flex',alignItems:'center',
      padding:'0 1.5rem',justifyContent:'space-between',gap:'1rem' }}>

      <Link to="/" style={{ fontFamily:'Syne,sans-serif',fontWeight:800,fontSize:'1.35rem',
        background:'linear-gradient(135deg,#00e5a0,#00b4ff)',
        WebkitBackgroundClip:'text',WebkitTextFillColor:'transparent',whiteSpace:'nowrap' }}>
        CouponX
      </Link>

      {/* Desktop */}
      <div style={{ display:'flex',gap:'1.6rem',alignItems:'center',flexWrap:'nowrap' }}>
        {links.map(l => (
          <Link key={l.to} to={l.to} style={{
            color: active(l.to) ? 'var(--acc)' : 'var(--mut)',
            fontSize:'.88rem',fontWeight:500,transition:'color .2s',whiteSpace:'nowrap'
          }}>{l.label}</Link>
        ))}
        {user ? (
          <>
            <span style={{ fontSize:'.82rem',color:'var(--mut)',whiteSpace:'nowrap' }}>
              {user.role === 'seller' ? '🏪' : '🛒'} {user.name.split(' ')[0]}
            </span>
            <button className="btn btn-sm btn-secondary" onClick={doLogout}>Logout</button>
          </>
        ) : (
          <div style={{ display:'flex',gap:'.6rem' }}>
            <Link to="/login"    className="btn btn-sm btn-secondary">Login</Link>
            <Link to="/register" className="btn btn-sm btn-primary">Sign Up</Link>
          </div>
        )}
      </div>
    </nav>
  );
}

import React, { useState, useRef, useEffect } from 'react';
import { chatAPI } from '../services/api';
import { useAuth } from '../context/AuthContext';

const INIT = [{ role:'assistant', content:"👋 Hi! I'm CouponX Support. Ask me anything about buying, selling, payments, OTPs, or refunds!" }];
const QUICK = ['How does escrow work?','Why is my code hidden?','How to get a refund?','How to sell a coupon?'];

export default function ChatWidget() {
  const [open, setOpen] = useState(false);
  const [msgs, setMsgs] = useState(INIT);
  const [inp,  setInp]  = useState('');
  const [busy, setBusy] = useState(false);
  const [unread, setUnread] = useState(0);
  const boxRef = useRef(null);
  const { user } = useAuth();

  useEffect(() => { if (boxRef.current) boxRef.current.scrollTop = boxRef.current.scrollHeight; }, [msgs]);
  useEffect(() => { if (open) setUnread(0); }, [open]);

  const send = async (text) => {
    const msg = (text || inp).trim();
    if (!msg || busy) return;
    setMsgs(m => [...m, { role:'user', content:msg }]);
    setInp('');
    setBusy(true);
    try {
      const history = msgs.map(m => ({ role:m.role, content:m.content }));
      const { data } = await chatAPI.send(msg, history);
      setMsgs(m => [...m, { role:'assistant', content:data.data.content }]);
      if (!open) setUnread(u => u+1);
    } catch {
      setMsgs(m => [...m, { role:'assistant', content:"I'm having trouble. Email support@couponx.in for urgent help 🙏" }]);
    } finally { setBusy(false); }
  };

  return (
    <>
      {/* Bubble */}
      <button onClick={() => setOpen(o => !o)} style={{
        position:'fixed',bottom:'1.8rem',right:'1.8rem',zIndex:400,
        width:54,height:54,borderRadius:'50%',border:'none',cursor:'pointer',
        background:'linear-gradient(135deg,#00e5a0,#00b4ff)',fontSize:'1.3rem',
        boxShadow:'0 4px 25px rgba(0,229,160,.35)',transition:'transform .2s',
        display:'flex',alignItems:'center',justifyContent:'center'
      }}
        onMouseEnter={e=>e.currentTarget.style.transform='scale(1.1)'}
        onMouseLeave={e=>e.currentTarget.style.transform=''}>
        {open ? '✕' : '💬'}
        {unread > 0 && !open && <span style={{ position:'absolute',top:-4,right:-4,
          background:'var(--err)',color:'#fff',width:18,height:18,borderRadius:'50%',
          fontSize:'.6rem',fontWeight:700,display:'flex',alignItems:'center',justifyContent:'center' }}>{unread}</span>}
      </button>

      {/* Window */}
      {open && (
        <div style={{ position:'fixed',bottom:'5.5rem',right:'1.8rem',zIndex:400,
          width:340,height:490,background:'var(--sur)',border:'1px solid var(--bdr)',
          borderRadius:20,display:'flex',flexDirection:'column',overflow:'hidden',
          boxShadow:'0 20px 60px rgba(0,0,0,.55)',animation:'fu .25s ease' }}>

          {/* Header */}
          <div style={{ padding:'.9rem 1.1rem',borderBottom:'1px solid var(--bdr)',
            background:'var(--sur2)',display:'flex',alignItems:'center',gap:'.65rem' }}>
            <div style={{ width:9,height:9,borderRadius:'50%',background:'var(--acc)',animation:'pulse 1.5s ease infinite' }}/>
            <div>
              <div style={{ fontFamily:'Syne,sans-serif',fontWeight:700,fontSize:'.88rem' }}>CouponX Support</div>
              <div style={{ fontSize:'.65rem',color:'var(--mut)' }}>AI-powered · Instant replies</div>
            </div>
          </div>

          {/* Messages */}
          <div ref={boxRef} style={{ flex:1,overflowY:'auto',padding:'1rem',display:'flex',flexDirection:'column',gap:'.75rem' }}>
            {msgs.map((m,i) => (
              <div key={i} style={{ display:'flex',gap:'.55rem',flexDirection:m.role==='user'?'row-reverse':'row',alignItems:'flex-end' }}>
                <div style={{ width:26,height:26,borderRadius:'50%',flexShrink:0,fontSize:'.75rem',
                  background:m.role==='assistant'?'linear-gradient(135deg,#00e5a0,#00b4ff)':'var(--pur)',
                  display:'flex',alignItems:'center',justifyContent:'center',color:m.role==='assistant'?'#000':'#fff' }}>
                  {m.role==='assistant'?'🤖':(user?.name?.[0]||'U')}
                </div>
                <div style={{ maxWidth:'78%',padding:'.6rem .85rem',borderRadius:12,fontSize:'.82rem',lineHeight:1.55,
                  background:m.role==='assistant'?'var(--sur2)':'var(--pur)',
                  border:m.role==='assistant'?'1px solid var(--bdr)':'none',
                  color:m.role==='user'?'#fff':'var(--txt)' }}>
                  {m.content}
                </div>
              </div>
            ))}
            {busy && (
              <div style={{ display:'flex',gap:'.55rem',alignItems:'flex-end' }}>
                <div style={{ width:26,height:26,borderRadius:'50%',background:'linear-gradient(135deg,#00e5a0,#00b4ff)',display:'flex',alignItems:'center',justifyContent:'center',fontSize:'.75rem' }}>🤖</div>
                <div style={{ background:'var(--sur2)',border:'1px solid var(--bdr)',padding:'.6rem .85rem',borderRadius:12,display:'flex',gap:4 }}>
                  {[0,150,300].map(d=><span key={d} style={{ width:6,height:6,borderRadius:'50%',background:'var(--mut)',display:'inline-block',animation:`pulse 1s ${d}ms ease infinite` }}/>)}
                </div>
              </div>
            )}
            {msgs.length === 1 && (
              <div style={{ display:'flex',flexWrap:'wrap',gap:'.38rem' }}>
                {QUICK.map(q=>(
                  <button key={q} onClick={()=>send(q)} style={{ background:'rgba(0,229,160,.08)',border:'1px solid rgba(0,229,160,.2)',
                    color:'var(--acc)',padding:'.28rem .6rem',borderRadius:100,fontSize:'.68rem',cursor:'pointer' }}>{q}</button>
                ))}
              </div>
            )}
          </div>

          {/* Input */}
          <div style={{ padding:'.7rem .9rem',borderTop:'1px solid var(--bdr)',background:'var(--sur2)',display:'flex',gap:'.5rem' }}>
            <input className="fi" style={{ flex:1,padding:'.52rem .85rem',fontSize:'.83rem' }}
              value={inp} onChange={e=>setInp(e.target.value)}
              onKeyDown={e=>e.key==='Enter'&&send()}
              placeholder="Type a message..." />
            <button onClick={()=>send()} disabled={busy||!inp.trim()} style={{
              background:'var(--acc)',color:'#000',border:'none',width:34,height:34,
              borderRadius:9,cursor:'pointer',fontSize:'.95rem',flexShrink:0,
              opacity:busy||!inp.trim()?.5:1,transition:'opacity .2s' }}>➤</button>
          </div>
        </div>
      )}
    </>
  );
}

:root{--bg:#080c14;--sur:#0f1520;--sur2:#161e2e;--bdr:rgba(255,255,255,.07);--acc:#00e5a0;--pur:#7c3aed;--amb:#f59e0b;--txt:#e8edf5;--mut:#6b7a99;--err:#ef4444}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--txt);overflow-x:hidden;min-height:100vh}
h1,h2,h3,h4{font-family:'Syne',sans-serif;font-weight:800}
a{color:inherit;text-decoration:none}
input,select,textarea,button{font-family:'DM Sans',sans-serif}

.page{padding-top:72px;min-height:100vh}
.container{max-width:1200px;margin:0 auto;padding:0 1.5rem}

/* Buttons */
.btn{display:inline-flex;align-items:center;gap:.45rem;padding:.7rem 1.4rem;border-radius:10px;font-weight:600;font-size:.88rem;border:none;cursor:pointer;transition:all .2s}
.btn:disabled{opacity:.5;cursor:not-allowed;transform:none!important}
.btn-primary{background:var(--acc);color:#000;box-shadow:0 0 20px rgba(0,229,160,.2)}
.btn-primary:hover:not(:disabled){opacity:.85;transform:translateY(-1px)}
.btn-secondary{background:transparent;color:var(--txt);border:1px solid var(--bdr)}
.btn-secondary:hover:not(:disabled){border-color:rgba(255,255,255,.18);background:rgba(255,255,255,.04)}
.btn-purple{background:var(--pur);color:#fff}
.btn-purple:hover:not(:disabled){opacity:.85}
.btn-danger{background:var(--err);color:#fff}
.btn-sm{padding:.42rem .85rem;font-size:.78rem;border-radius:8px}
.btn-full{width:100%;justify-content:center}

/* Form */
.fg{display:flex;flex-direction:column;gap:.38rem;margin-bottom:1.1rem}
.fl{font-size:.8rem;color:var(--mut);font-weight:500}
.fi,.fs{background:var(--sur2);border:1px solid var(--bdr);border-radius:10px;color:var(--txt);padding:.68rem 1rem;font-size:.88rem;outline:none;width:100%;transition:border-color .2s}
.fi:focus,.fs:focus{border-color:var(--acc)}
.fi::placeholder{color:var(--mut)}
.fs option{background:var(--sur2)}
.fe{color:var(--err);font-size:.74rem;margin-top:.2rem}
.f2{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
@media(max-width:580px){.f2{grid-template-columns:1fr}}

/* Cards */
.card{background:var(--sur);border:1px solid var(--bdr);border-radius:18px;padding:1.5rem;transition:border-color .2s,transform .2s}
.card:hover{border-color:rgba(255,255,255,.12)}

/* Badges */
.bdg{display:inline-flex;align-items:center;gap:.28rem;padding:.22rem .6rem;border-radius:100px;font-size:.7rem;font-weight:600}
.bdg-g{background:rgba(0,229,160,.1);color:var(--acc);border:1px solid rgba(0,229,160,.2)}
.bdg-p{background:rgba(124,58,237,.1);color:#a78bfa;border:1px solid rgba(124,58,237,.2)}
.bdg-a{background:rgba(245,158,11,.1);color:var(--amb);border:1px solid rgba(245,158,11,.2)}
.bdg-r{background:rgba(239,68,68,.1);color:var(--err);border:1px solid rgba(239,68,68,.2)}

/* Modal */
.mo{position:fixed;inset:0;z-index:500;background:rgba(0,0,0,.82);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;padding:1rem;animation:fi .2s ease}
.md{background:var(--sur);border:1px solid var(--bdr);border-radius:24px;padding:2rem;width:100%;max-width:480px;position:relative;animation:fu .25s ease}
.mc{position:absolute;top:1rem;right:1.2rem;background:none;border:none;color:var(--mut);font-size:1.5rem;cursor:pointer;line-height:1}

/* Deal bar */
.db{height:6px;background:rgba(255,255,255,.07);border-radius:100px;overflow:hidden}
.df{height:100%;border-radius:100px;transition:width 1s ease}

/* Spinner */
.spin{width:36px;height:36px;border-radius:50%;border:3px solid rgba(0,229,160,.15);border-top-color:var(--acc);animation:sp .8s linear infinite;margin:0 auto}
.ls{width:100%;height:100%;display:flex;align-items:center;justify-content:center;padding:4rem}

/* OTP */
.otp-inp{font-family:monospace;font-size:2rem;font-weight:800;text-align:center;letter-spacing:.35em;background:var(--sur2);border:2px solid var(--acc);border-radius:12px;padding:1rem;color:var(--acc);width:100%;outline:none}

/* Grid */
.g-auto{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:1.1rem}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
@media(max-width:640px){.g2{grid-template-columns:1fr}}
.divider{height:1px;background:var(--bdr);margin:1.2rem 0}

/* Animations */
@keyframes fi{from{opacity:0}to{opacity:1}}
@keyframes fu{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
@keyframes sp{to{transform:rotate(360deg)}}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.45}}
.ani-up{animation:fu .45s ease both}
.skel{animation:pulse 1.4s ease infinite;background:var(--sur);border-radius:18px;border:1px solid var(--bdr)}

import axios from 'axios';

const BASE = process.env.REACT_APP_API_URL || '/api';

const api = axios.create({ baseURL: BASE, timeout: 15000, headers: { 'Content-Type': 'application/json' } });

api.interceptors.request.use(cfg => {
  const t = localStorage.getItem('cx_token');
  if (t) cfg.headers.Authorization = `Bearer ${t}`;
  return cfg;
});

api.interceptors.response.use(r => r, async err => {
  const orig = err.config;
  if (err.response?.status === 401 && err.response?.data?.code === 'TOKEN_EXPIRED' && !orig._retry) {
    orig._retry = true;
    try {
      const rt = localStorage.getItem('cx_refresh');
      const { data } = await axios.post(`${BASE}/auth/refresh`, { refreshToken: rt });
      localStorage.setItem('cx_token', data.accessToken);
      orig.headers.Authorization = `Bearer ${data.accessToken}`;
      return api(orig);
    } catch { localStorage.clear(); window.location.href = '/login'; }
  }
  return Promise.reject(err);
});

export const authAPI = {
  register: d => api.post('/auth/register', d),
  login:    d => api.post('/auth/login', d),
  logout:   () => api.post('/auth/logout'),
  me:       () => api.get('/auth/me')
};

export const couponAPI = {
  list:       p => api.get('/coupons', { params: p }),
  get:        id => api.get(`/coupons/${id}`),
  create:     d => api.post('/coupons', d),
  remove:     id => api.delete(`/coupons/${id}`),
  myListings: () => api.get('/coupons/my/listings')
};

export const paymentAPI = {
  initiate:  id  => api.post('/payments/initiate', { couponId: id }),
  verifyOTP: (txnId, otp) => api.post('/payments/verify-otp', { txnId, otp }),
  status:    txnId => api.get(`/payments/status/${txnId}`),
  history:   () => api.get('/payments/history')
};

export const chatAPI = {
  send: (message, history) => api.post('/chat', { message, history })
};

export default api;

import React from 'react';
import { BrowserRouter, Routes, Route, Navigate } from 'react-router-dom';
import { Toaster } from 'react-hot-toast';
import { AuthProvider, useAuth } from './context/AuthContext';
import Navbar      from './components/Navbar';
import ChatWidget  from './components/ChatWidget';
import Home        from './pages/Home';
import Login       from './pages/Login';
import Register    from './pages/Register';
import Marketplace from './pages/Marketplace';
import SellCoupon  from './pages/SellCoupon';
import Dashboard   from './pages/Dashboard';
import Payment     from './pages/Payment';

const Guard = ({ children, roles }) => {
  const { user, loading } = useAuth();
  if (loading) return <div className="ls"><div className="spin"/></div>;
  if (!user)   return <Navigate to="/login" replace/>;
  if (roles && !roles.includes(user.role)) return <Navigate to="/" replace/>;
  return children;
};

function Inner() {
  return (
    <BrowserRouter>
      <Navbar/>
      <Routes>
        <Route path="/"           element={<Home/>}/>
        <Route path="/login"      element={<Login/>}/>
        <Route path="/register"   element={<Register/>}/>
        <Route path="/marketplace"element={<Marketplace/>}/>
        <Route path="/sell"       element={<Guard roles={['seller','admin']}><SellCoupon/></Guard>}/>
        <Route path="/dashboard"  element={<Guard><Dashboard/></Guard>}/>
        <Route path="/payment/*"  element={<Guard roles={['buyer','admin']}><Payment/></Guard>}/>
        <Route path="*"           element={<Navigate to="/" replace/>}/>
      </Routes>
      <ChatWidget/>
      <Toaster position="bottom-right" toastOptions={{
        style:{ background:'var(--sur)',color:'var(--txt)',border:'1px solid var(--bdr)' },
        success:{ iconTheme:{ primary:'var(--acc)',secondary:'#000' } }
      }}/>
    </BrowserRouter>
  );
}

export default function App() {
  return <AuthProvider><Inner/></AuthProvider>;
}

